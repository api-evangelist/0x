            "headers": [
              {
                "name": "0x-api-key",
                "value": ""
              },
              {
                "name": "0x-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chainId",
                "value": "1",
                "type": "query",
                "description": "Chain ID. See [here](https://docs.0x.org/docs/introduction/supported-chains) for the list of supported chains"
              }
            ]
          },
          "docs": "Get the list of supported sources"
        }
      ]
    }
  ],
  "bundled": true
}