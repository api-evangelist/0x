{
  "opencollection": "1.0.0",
  "info": {
    "name": "0x Cross-Chain Sources API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Liquidity Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
